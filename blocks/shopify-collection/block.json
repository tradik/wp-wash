{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "wash/shopify-collection",
    "version": "1.0.0",
    "title": "Shopify Collection",
    "category": "embed",
    "icon": "grid-view",
    "description": "Embed products from a Shopify collection.",
    "keywords": ["shopify", "collection", "products", "embed", "wash", "ecommerce", "grid"],
    "textdomain": "wash",
    "attributes": {
        "collectionId": {
            "type": "string",
            "default": ""
        },
        "handle": {
            "type": "string",
            "default": ""
        },
        "limit": {
            "type": "number",
            "default": 4
        },
        "columns": {
            "type": "number",
            "default": 4
        }
    },
    "supports": {
        "html": false,
        "align": ["wide", "full"],
        "spacing": {
            "margin": true,
            "padding": true
        }
    },
    "editorScript": "file:./index.js",
    "style": "file:./style.css"
}
