{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "wash/shopify-product",
    "version": "1.0.0",
    "title": "Shopify Product",
    "category": "embed",
    "icon": "cart",
    "description": "Embed a Shopify product in your content.",
    "keywords": ["shopify", "product", "embed", "wash", "ecommerce"],
    "textdomain": "wash",
    "attributes": {
        "productId": {
            "type": "string",
            "default": ""
        },
        "handle": {
            "type": "string",
            "default": ""
        },
        "displayType": {
            "type": "string",
            "default": "card",
            "enum": ["card", "minimal", "full"]
        },
        "showPrice": {
            "type": "boolean",
            "default": true
        },
        "showAddToCart": {
            "type": "boolean",
            "default": true
        }
    },
    "supports": {
        "html": false,
        "align": ["wide", "full"],
        "spacing": {
            "margin": true,
            "padding": true
        }
    },
    "editorScript": "file:./index.js",
    "style": "file:./style.css"
}
