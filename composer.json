{
    "name": "tradik/wash",
    "description": "Wash: Blog Manager — WordPress to Shopify sync plugin",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "brain/monkey": "^2.7",
        "mockery/mockery": "^1.6.15"
    },
    "autoload": {
        "classmap": [
            "includes/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Wash\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-html=coverage"
    },
    "config": {
        "allow-plugins": {
            "phpunit/phpunit": true
        }
    }
}
