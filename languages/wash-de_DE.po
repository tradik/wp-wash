msgstr "Weiterleitungsliste"

msgid "format: /old-path -> /new-path"
msgstr "Format: /alter-pfad -> /neuer-pfad"

msgid "Enter one redirection per line. You can use ->, =>, or → as separator. Lines starting with # are ignored."
msgstr "Geben Sie eine Weiterleitung pro Zeile ein. Sie können ->, => oder → als Trennzeichen verwenden. Zeilen, die mit # beginnen, werden ignoriert."

msgid "Sync Redirections to Shopify"
msgstr "Weiterleitungen zu Shopify synchronisieren"

msgid "Sync Complete"
msgstr "Synchronisierung abgeschlossen"

msgid "Connect to Shopify first to manage redirections."
msgstr "Verbinden Sie sich zuerst mit Shopify, um Weiterleitungen zu verwalten."

msgid "URL Structure Guide"
msgstr "URL-Struktur-Anleitung"

msgid "WordPress URL Structure (Current)"
msgstr "WordPress URL-Struktur (aktuell)"

msgid "Your WordPress site currently serves content with these URL patterns:"
msgstr "Ihre WordPress-Site stellt derzeit Inhalte mit diesen URL-Mustern bereit:"

msgid "Blog Posts"
msgstr "Blog-Beiträge"

msgid "Permalink structure depends on Settings → Permalinks"
msgstr "Permalink-Struktur hängt von Einstellungen → Permalinks ab"

msgid "Pages"
msgstr "Seiten"

msgid "Page slug becomes the URL"
msgstr "Seiten-Slug wird zur URL"

msgid "Categories"
msgstr "Kategorien"

msgid "Category archives with pagination"
msgstr "Kategoriearchive mit Paginierung"

msgid "Images"
msgstr "Bilder"

msgid "Served from your WordPress server"
msgstr "Von Ihrem WordPress-Server bereitgestellt"

msgid "Shopify URL Structure (After Sync)"
msgstr "Shopify URL-Struktur (nach Synchronisierung)"

msgid "After syncing, your content will be available on Shopify with these URL patterns:"
msgstr "Nach der Synchronisierung sind Ihre Inhalte auf Shopify mit diesen URL-Mustern verfügbar:"

msgid "Blog handle is required in Shopify URLs. Configure in Blogs tab."
msgstr "Blog-Handle ist in Shopify-URLs erforderlich. Konfigurieren Sie im Blogs-Tab."

msgid "Multi-language Posts"
msgstr "Mehrsprachige Beiträge"

msgid "English"
msgstr "Englisch"

msgid "German"
msgstr "Deutsch"

msgid "Polish"
msgstr "Polnisch"

msgid "Each language gets its own blog with routing rules."
msgstr "Jede Sprache bekommt ihren eigenen Blog mit Routing-Regeln."

msgid "Pages are prefixed with /pages/ in Shopify."
msgstr "Seiten haben in Shopify das Präfix /pages/."

msgid "Images are uploaded to Shopify CDN for faster global delivery."
msgstr "Bilder werden zum Shopify CDN hochgeladen für schnellere globale Bereitstellung."

msgid "Image Handling"
msgstr "Bildverarbeitung"

msgid "Image Type"
msgstr "Bildtyp"

msgid "What Happens"
msgstr "Was passiert"

msgid "Featured Image"
msgstr "Beitragsbild"

msgid "Uploaded to Shopify and set as article image. Displayed in blog listings and article headers."
msgstr "Zu Shopify hochgeladen und als Artikelbild gesetzt. Angezeigt in Blog-Listen und Artikelüberschriften."

msgid "Inline Images"
msgstr "Inline-Bilder"

msgid "Uploaded to Shopify CDN. URLs in content are automatically rewritten."
msgstr "Zum Shopify CDN hochgeladen. URLs im Inhalt werden automatisch umgeschrieben."

msgid "Gallery Images"
msgstr "Galerie-Bilder"

msgid "Uploaded to Shopify CDN. Gallery shortcodes converted to HTML."
msgstr "Zum Shopify CDN hochgeladen. Galerie-Shortcodes werden in HTML konvertiert."

msgid "Requires %s plan"
msgstr "Erfordert %s-Plan"

msgid "None detected"
msgstr "Keine erkannt"

msgid "Settings"
msgstr "Einstellungen"

msgid "Sync Now"
msgstr "Jetzt synchronisieren"

msgid "Sync in progress..."
msgstr "Synchronisierung läuft..."

msgid "Synced successfully"
msgstr "Erfolgreich synchronisiert"

msgid "Sync failed"
msgstr "Synchronisierung fehlgeschlagen"

msgid "Last synced:"
msgstr "Zuletzt synchronisiert:"

msgid "Never synced"
msgstr "Nie synchronisiert"

msgid "Error:"
msgstr "Fehler:"

msgid "Success:"
msgstr "Erfolg:"

msgid "Hreflang Synchronization"
msgstr "Hreflang-Synchronisierung"

msgid "Enable hreflang synchronization"
msgstr "Hreflang-Synchronisierung aktivieren"

msgid "Detected multilingual plugin:"
msgstr "Erkanntes mehrsprachiges Plugin:"

msgid "Automatically sync hreflang tags for multilingual content."
msgstr "Hreflang-Tags für mehrsprachige Inhalte automatisch synchronisieren."

msgid "Custom Fields Sync"
msgstr "Benutzerdefinierte Felder synchronisieren"

msgid "Enable custom fields sync"
msgstr "Synchronisierung benutzerdefinierter Felder aktivieren"

msgid "Sync ACF and custom meta fields as Shopify metafields."
msgstr "ACF und benutzerdefinierte Meta-Felder als Shopify-Metafelder synchronisieren."

msgid "Author Mapping"
msgstr "Autorenzuordnung"

msgid "Map WordPress authors to Shopify staff accounts."
msgstr "WordPress-Autoren zu Shopify-Mitarbeiterkonten zuordnen."

msgid "WordPress Author"
msgstr "WordPress-Autor"

msgid "Shopify Staff"
msgstr "Shopify-Mitarbeiter"

msgid "Select staff member"
msgstr "Mitarbeiter auswählen"

msgid "Save Author Mappings"
msgstr "Autorenzuordnungen speichern"

msgid "Post Types to Sync"
msgstr "Zu synchronisierende Beitragstypen"

msgid "Select which post types should be synced to Shopify."
msgstr "Wählen Sie, welche Beitragstypen zu Shopify synchronisiert werden sollen."

msgid "Automatic Sync"
msgstr "Automatische Synchronisierung"

msgid "Automatically sync content when published or updated."
msgstr "Inhalte beim Veröffentlichen oder Aktualisieren automatisch synchronisieren."

msgid "Sync on Publish"
msgstr "Bei Veröffentlichung synchronisieren"

msgid "Sync on Update"
msgstr "Bei Aktualisierung synchronisieren"

msgid "Sync on Delete"
msgstr "Bei Löschung synchronisieren"

msgid "Delete from Shopify when trashed in WordPress."
msgstr "Aus Shopify löschen, wenn in WordPress in den Papierkorb verschoben."

msgid "Debug Mode"
msgstr "Debug-Modus"

msgid "Enable debug logging"
msgstr "Debug-Protokollierung aktivieren"

msgid "Log detailed sync information for troubleshooting."
msgstr "Detaillierte Sync-Informationen zur Fehlerbehebung protokollieren."

msgid "Clear All Data"
msgstr "Alle Daten löschen"

msgid "Remove all sync data and mappings"
msgstr "Alle Sync-Daten und Zuordnungen entfernen"

msgid "This will clear all sync history and Shopify article IDs. Use with caution."
msgstr "Dies löscht den gesamten Sync-Verlauf und Shopify-Artikel-IDs. Mit Vorsicht verwenden."

msgid "Save Settings"
msgstr "Einstellungen speichern"
