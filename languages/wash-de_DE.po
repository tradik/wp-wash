msgstr "Nach Sprache"

msgid "By Category"
msgstr "Nach Kategorie"

msgid "Value"
msgstr "Wert"

msgid "Language code (en, de, pl) or category slug"
msgstr "Sprachcode (en, de, pl) oder Kategorie-Slug"

