msgstr "Regeln mit höherer Priorität werden zuerst abgeglichen (0-100)"

msgid "Save Mapping"
msgstr "Zuordnung speichern"

msgid "Cancel"
msgstr "Abbrechen"

msgid "URL Redirections Management"
msgstr "URL-Weiterleitungsverwaltung"

msgid "Manage 301 redirects from WordPress URLs to Shopify URLs for SEO preservation during migration."
msgstr "Verwalten Sie 301-Weiterleitungen von WordPress-URLs zu Shopify-URLs zur SEO-Erhaltung während der Migration."

msgid "Redirections Manager"
msgstr "Weiterleitungsmanager"

msgid "Loading redirect stats..."
msgstr "Weiterleitungsstatistiken werden geladen..."

msgid "Sync from Old Website"
msgstr "Von alter Website synchronisieren"

msgid "Generate from Synced Posts"
msgstr "Aus synchronisierten Beiträgen generieren"

msgid "Load from Shopify"
msgstr "Von Shopify laden"

msgid "Fix Session Scopes"
msgstr "Sitzungsbereiche reparieren"

