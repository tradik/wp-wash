msgstr "Conectado"

msgid "Shopify Store"
msgstr "Tienda Shopify"

msgid "Your Shopify store handle (e.g., \"my-store\" from my-store.myshopify.com)"
msgstr "El identificador de tu tienda Shopify (ej. \"mi-tienda\" de mi-tienda.myshopify.com)"

msgid "Connect to Shopify"
msgstr "Conectar con Shopify"

msgid "Disconnect"
msgstr "Desconectar"

msgid "Manual Configuration"
msgstr "Configuración manual"

msgid "If automatic connection fails, you can enter credentials manually."
msgstr "Si la conexión automática falla, puedes introducir las credenciales manualmente."

msgid "API Key"
msgstr "Clave API"

