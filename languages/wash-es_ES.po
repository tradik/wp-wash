msgstr "Contraseña HTTP"

msgid "Test Connection"
msgstr "Probar conexión"

msgid "Debug Session"
msgstr "Depurar sesión"

msgid "Reset Session"
msgstr "Reiniciar sesión"

msgid "Blog Routing Rules"
msgstr "Reglas de enrutamiento de blogs"

msgid "Route WordPress posts to different Shopify blogs based on language or category."
msgstr "Enruta los posts de WordPress a diferentes blogs de Shopify según el idioma o categoría."

msgid "Higher priority rules are matched first. Default rule is used when no other rule matches."
msgstr "Las reglas de mayor prioridad se procesan primero. La regla por defecto se usa cuando ninguna otra coincide."

msgid "Connect to Shopify first to configure blog mappings."
msgstr "Conéctate primero a Shopify para configurar los mapeos de blogs."

msgid "Loading mappings..."
msgstr "Cargando mapeos..."

msgid "Add Mapping Rule"
msgstr "Añadir regla de mapeo"

msgid "Rule Type"
msgstr "Tipo de regla"

msgid "Default (catch-all)"
msgstr "Por defecto (catch-all)"

msgid "By Language"
msgstr "Por idioma"

msgid "By Category"
msgstr "Por categoría"

msgid "Value"
msgstr "Valor"

msgid "Language code (en, de, pl) or category slug"
msgstr "Código de idioma (en, de, pl) o slug de categoría"

msgid "Target Shopify Blog"
msgstr "Blog Shopify destino"

msgid "Select a blog..."
msgstr "Seleccionar un blog..."

msgid "Create new blog"
msgstr "Crear nuevo blog"

msgid "New blog name (e.g., blog-en)"
msgstr "Nombre del nuevo blog (ej. blog-es)"

msgid "Priority"
msgstr "Prioridad"

msgid "Higher priority rules are matched first (0-100)"
msgstr "Las reglas de mayor prioridad se procesan primero (0-100)"

msgid "Save Mapping"
msgstr "Guardar mapeo"

msgid "Cancel"
msgstr "Cancelar"

msgid "URL Redirections Management"
msgstr "Gestión de redirecciones URL"

msgid "Manage 301 redirects from WordPress URLs to Shopify URLs for SEO preservation during migration."
msgstr "Gestiona las redirecciones 301 de URLs de WordPress a URLs de Shopify para preservar el SEO durante la migración."

msgid "Redirections Manager"
msgstr "Gestor de redirecciones"

msgid "Loading redirect stats..."
msgstr "Cargando estadísticas de redirecciones..."

msgid "Sync from Old Website"
msgstr "Sincronizar desde sitio antiguo"

msgid "Generate from Synced Posts"
msgstr "Generar desde posts sincronizados"

msgid "Load from Shopify"
msgstr "Cargar desde Shopify"

msgid "Fix Session Scopes"
msgstr "Corregir ámbitos de sesión"

msgid "Redirections List"
msgstr "Lista de redirecciones"

msgid "format: /old-path -> /new-path"
msgstr "formato: /ruta-antigua -> /ruta-nueva"

msgid "Enter one redirection per line. You can use ->, =>, or → as separator. Lines starting with # are ignored."
msgstr "Introduce una redirección por línea. Puedes usar ->, => o → como separador. Las líneas que empiezan con # se ignoran."

msgid "Sync Redirections to Shopify"
msgstr "Sincronizar redirecciones a Shopify"

msgid "Sync Complete"
msgstr "Sincronización completada"

msgid "Connect to Shopify first to manage redirections."
msgstr "Conéctate primero a Shopify para gestionar las redirecciones."

msgid "URL Structure Guide"
msgstr "Guía de estructura URL"

msgid "WordPress URL Structure (Current)"
msgstr "Estructura URL de WordPress (Actual)"

msgid "Your WordPress site currently serves content with these URL patterns:"
msgstr "Tu sitio WordPress actualmente sirve contenido con estos patrones de URL:"

msgid "Blog Posts"
msgstr "Entradas del blog"

msgid "Permalink structure depends on Settings → Permalinks"
msgstr "La estructura de enlaces permanentes depende de Ajustes → Enlaces permanentes"

msgid "Pages"
msgstr "Páginas"

msgid "Page slug becomes the URL"
msgstr "El slug de la página se convierte en la URL"

msgid "Categories"
msgstr "Categorías"

msgid "Category archives with pagination"
msgstr "Archivos de categorías con paginación"

msgid "Images"
msgstr "Imágenes"

msgid "Served from your WordPress server"
msgstr "Servido desde tu servidor WordPress"

msgid "Shopify URL Structure (After Sync)"
msgstr "Estructura URL de Shopify (Después de sincronizar)"

msgid "After syncing, your content will be available on Shopify with these URL patterns:"
msgstr "Después de sincronizar, tu contenido estará disponible en Shopify con estos patrones de URL:"

msgid "Blog handle is required in Shopify URLs. Configure in Blogs tab."
msgstr "El identificador del blog es requerido en las URLs de Shopify. Configura en la pestaña Blogs."

msgid "Multi-language Posts"
msgstr "Posts multiidioma"

msgid "English"
msgstr "Inglés"

msgid "German"
msgstr "Alemán"

msgid "Polish"
msgstr "Polaco"

msgid "Each language gets its own blog with routing rules."
msgstr "Cada idioma tiene su propio blog con reglas de enrutamiento."

msgid "Pages are prefixed with /pages/ in Shopify."
msgstr "Las páginas tienen el prefijo /pages/ en Shopify."

msgid "Images are uploaded to Shopify CDN for faster global delivery."
msgstr "Las imágenes se suben al CDN de Shopify para una entrega global más rápida."

msgid "Image Handling"
msgstr "Gestión de imágenes"

msgid "Image Type"
msgstr "Tipo de imagen"

msgid "What Happens"
msgstr "Qué sucede"

msgid "Featured Image"
msgstr "Imagen destacada"

msgid "Uploaded to Shopify and set as article image. Displayed in blog listings and article headers."
msgstr "Subida a Shopify y establecida como imagen del artículo. Mostrada en listados de blog y cabeceras de artículos."

msgid "Inline Images"
msgstr "Imágenes en línea"

msgid "Uploaded to Shopify CDN. URLs in content are automatically rewritten."
msgstr "Subidas al CDN de Shopify. Las URLs en el contenido se reescriben automáticamente."

msgid "Gallery Images"
msgstr "Imágenes de galería"

msgid "Uploaded to Shopify CDN. Gallery shortcodes converted to HTML."
msgstr "Subidas al CDN de Shopify. Los shortcodes de galería se convierten a HTML."

msgid "Requires %s plan"
msgstr "Requiere el plan %s"

msgid "None detected"
msgstr "Ninguno detectado"

msgid "Settings"
msgstr "Configuración"

msgid "Sync Now"
msgstr "Sincronizar ahora"

msgid "Sync in progress..."
msgstr "Sincronización en progreso..."

msgid "Synced successfully"
msgstr "Sincronizado correctamente"

msgid "Sync failed"
msgstr "Falló la sincronización"

msgid "Last synced:"
msgstr "Última sincronización:"

msgid "Never synced"
msgstr "Nunca sincronizado"

msgid "Error:"
msgstr "Error:"

msgid "Success:"
msgstr "Éxito:"

msgid "Hreflang Synchronization"
msgstr "Sincronización Hreflang"

msgid "Enable hreflang synchronization"
msgstr "Activar sincronización hreflang"

msgid "Detected multilingual plugin:"
msgstr "Plugin multiidioma detectado:"

msgid "Automatically sync hreflang tags for multilingual content."
msgstr "Sincronizar automáticamente las etiquetas hreflang para contenido multiidioma."

msgid "Custom Fields Sync"
msgstr "Sincronización de campos personalizados"

msgid "Enable custom fields sync"
msgstr "Activar sincronización de campos personalizados"

msgid "Sync ACF and custom meta fields as Shopify metafields."
msgstr "Sincronizar campos ACF y metacampos personalizados como metacampos de Shopify."

msgid "Author Mapping"
msgstr "Mapeo de autores"

msgid "Map WordPress authors to Shopify staff accounts."
msgstr "Mapear autores de WordPress a cuentas de staff de Shopify."

msgid "WordPress Author"
msgstr "Autor WordPress"

msgid "Shopify Staff"
msgstr "Staff Shopify"

msgid "Select staff member"
msgstr "Seleccionar miembro del staff"

msgid "Save Author Mappings"
msgstr "Guardar mapeos de autores"

msgid "Post Types to Sync"
msgstr "Tipos de post a sincronizar"

msgid "Select which post types should be synced to Shopify."
msgstr "Selecciona qué tipos de post deben sincronizarse con Shopify."

msgid "Automatic Sync"
msgstr "Sincronización automática"

msgid "Automatically sync content when published or updated."
msgstr "Sincronizar automáticamente el contenido al publicar o actualizar."

msgid "Sync on Publish"
msgstr "Sincronizar al publicar"

msgid "Sync on Update"
msgstr "Sincronizar al actualizar"

msgid "Sync on Delete"
msgstr "Sincronizar al eliminar"

msgid "Delete from Shopify when trashed in WordPress."
msgstr "Eliminar de Shopify cuando se envía a la papelera en WordPress."

msgid "Debug Mode"
msgstr "Modo depuración"

msgid "Enable debug logging"
msgstr "Activar registro de depuración"

msgid "Log detailed sync information for troubleshooting."
msgstr "Registrar información detallada de sincronización para solución de problemas."

msgid "Clear All Data"
msgstr "Borrar todos los datos"

msgid "Remove all sync data and mappings"
msgstr "Eliminar todos los datos de sincronización y mapeos"

msgid "This will clear all sync history and Shopify article IDs. Use with caution."
msgstr "Esto borrará todo el historial de sincronización e IDs de artículos de Shopify. Usar con precaución."

msgid "Save Settings"
msgstr "Guardar configuración"
