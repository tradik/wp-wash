msgstr "Réinitialiser la session"

msgid "Blog Routing Rules"
msgstr "Règles de routage des blogs"

msgid "Route WordPress posts to different Shopify blogs based on language or category."
msgstr "Acheminez les articles WordPress vers différents blogs Shopify selon la langue ou la catégorie."

msgid "Higher priority rules are matched first. Default rule is used when no other rule matches."
msgstr "Les règles de priorité supérieure sont traitées en premier. La règle par défaut est utilisée quand aucune autre règle ne correspond."

msgid "Connect to Shopify first to configure blog mappings."
msgstr "Connectez-vous d'abord à Shopify pour configurer les mappages de blogs."

msgid "Loading mappings..."
msgstr "Chargement des mappages..."

msgid "Add Mapping Rule"
msgstr "Ajouter une règle de mappage"

msgid "Rule Type"
msgstr "Type de règle"

msgid "Default (catch-all)"
msgstr "Par défaut (catch-all)"

msgid "By Language"
msgstr "Par langue"

msgid "By Category"
msgstr "Par catégorie"

msgid "Value"
msgstr "Valeur"

msgid "Language code (en, de, pl) or category slug"
msgstr "Code de langue (en, de, pl) ou slug de catégorie"

msgid "Target Shopify Blog"
msgstr "Blog Shopify cible"

msgid "Select a blog..."
msgstr "Sélectionner un blog..."

msgid "Create new blog"
msgstr "Créer un nouveau blog"

msgid "New blog name (e.g., blog-en)"
msgstr "Nom du nouveau blog (ex. blog-fr)"

msgid "Priority"
msgstr "Priorité"

msgid "Higher priority rules are matched first (0-100)"
msgstr "Les règles de priorité supérieure sont traitées en premier (0-100)"

msgid "Save Mapping"
msgstr "Enregistrer le mappage"

msgid "Cancel"
msgstr "Annuler"

msgid "URL Redirections Management"
msgstr "Gestion des redirections URL"

msgid "Manage 301 redirects from WordPress URLs to Shopify URLs for SEO preservation during migration."
msgstr "Gérez les redirections 301 des URLs WordPress vers les URLs Shopify pour la préservation SEO lors de la migration."

msgid "Redirections Manager"
msgstr "Gestionnaire de redirections"

msgid "Loading redirect stats..."
msgstr "Chargement des statistiques de redirections..."

msgid "Sync from Old Website"
msgstr "Synchroniser depuis l'ancien site"

msgid "Generate from Synced Posts"
msgstr "Générer depuis les articles synchronisés"

msgid "Load from Shopify"
msgstr "Charger depuis Shopify"

msgid "Fix Session Scopes"
msgstr "Corriger les portées de session"

msgid "Redirections List"
msgstr "Liste des redirections"

msgid "format: /old-path -> /new-path"
msgstr "format : /ancien-chemin -> /nouveau-chemin"

msgid "Enter one redirection per line. You can use ->, =>, or → as separator. Lines starting with # are ignored."
msgstr "Entrez une redirection par ligne. Vous pouvez utiliser ->, => ou → comme séparateur. Les lignes commençant par # sont ignorées."

msgid "Sync Redirections to Shopify"
msgstr "Synchroniser les redirections vers Shopify"

msgid "Sync Complete"
msgstr "Synchronisation terminée"

msgid "Connect to Shopify first to manage redirections."
msgstr "Connectez-vous d'abord à Shopify pour gérer les redirections."

msgid "URL Structure Guide"
msgstr "Guide de structure URL"

msgid "WordPress URL Structure (Current)"
msgstr "Structure URL WordPress (Actuelle)"

msgid "Your WordPress site currently serves content with these URL patterns:"
msgstr "Votre site WordPress sert actuellement du contenu avec ces modèles d'URL :"

msgid "Blog Posts"
msgstr "Articles de blog"

msgid "Permalink structure depends on Settings → Permalinks"
msgstr "La structure des permaliens dépend de Réglages → Permaliens"

msgid "Pages"
msgstr "Pages"

msgid "Page slug becomes the URL"
msgstr "Le slug de la page devient l'URL"

msgid "Categories"
msgstr "Catégories"

msgid "Category archives with pagination"
msgstr "Archives de catégories avec pagination"

msgid "Images"
msgstr "Images"

msgid "Served from your WordPress server"
msgstr "Servi depuis votre serveur WordPress"

msgid "Shopify URL Structure (After Sync)"
msgstr "Structure URL Shopify (Après synchronisation)"

msgid "After syncing, your content will be available on Shopify with these URL patterns:"
msgstr "Après synchronisation, votre contenu sera disponible sur Shopify avec ces modèles d'URL :"

msgid "Blog handle is required in Shopify URLs. Configure in Blogs tab."
msgstr "L'identifiant du blog est requis dans les URLs Shopify. Configurez dans l'onglet Blogs."

msgid "Multi-language Posts"
msgstr "Articles multilingues"

msgid "English"
msgstr "Anglais"

msgid "German"
msgstr "Allemand"

msgid "Polish"
msgstr "Polonais"

msgid "Each language gets its own blog with routing rules."
msgstr "Chaque langue a son propre blog avec des règles de routage."

msgid "Pages are prefixed with /pages/ in Shopify."
msgstr "Les pages ont le préfixe /pages/ dans Shopify."

msgid "Images are uploaded to Shopify CDN for faster global delivery."
msgstr "Les images sont téléversées vers le CDN Shopify pour une livraison mondiale plus rapide."

msgid "Image Handling"
msgstr "Gestion des images"

msgid "Image Type"
msgstr "Type d'image"

msgid "What Happens"
msgstr "Ce qui se passe"

msgid "Featured Image"
msgstr "Image mise en avant"

msgid "Uploaded to Shopify and set as article image. Displayed in blog listings and article headers."
msgstr "Téléversée vers Shopify et définie comme image d'article. Affichée dans les listes de blog et les en-têtes d'articles."

msgid "Inline Images"
msgstr "Images en ligne"

msgid "Uploaded to Shopify CDN. URLs in content are automatically rewritten."
msgstr "Téléversées vers le CDN Shopify. Les URLs dans le contenu sont automatiquement réécrites."

msgid "Gallery Images"
msgstr "Images de galerie"

msgid "Uploaded to Shopify CDN. Gallery shortcodes converted to HTML."
msgstr "Téléversées vers le CDN Shopify. Les shortcodes de galerie sont convertis en HTML."

msgid "Requires %s plan"
msgstr "Nécessite le plan %s"

msgid "None detected"
msgstr "Aucun détecté"

msgid "Settings"
msgstr "Paramètres"

msgid "Sync Now"
msgstr "Synchroniser maintenant"

msgid "Sync in progress..."
msgstr "Synchronisation en cours..."

msgid "Synced successfully"
msgstr "Synchronisé avec succès"

msgid "Sync failed"
msgstr "Échec de la synchronisation"

msgid "Last synced:"
msgstr "Dernière synchronisation :"

msgid "Never synced"
msgstr "Jamais synchronisé"

msgid "Error:"
msgstr "Erreur :"

msgid "Success:"
msgstr "Succès :"

msgid "Hreflang Synchronization"
msgstr "Synchronisation Hreflang"

msgid "Enable hreflang synchronization"
msgstr "Activer la synchronisation hreflang"

msgid "Detected multilingual plugin:"
msgstr "Plugin multilingue détecté :"

msgid "Automatically sync hreflang tags for multilingual content."
msgstr "Synchroniser automatiquement les balises hreflang pour le contenu multilingue."

msgid "Custom Fields Sync"
msgstr "Synchronisation des champs personnalisés"

msgid "Enable custom fields sync"
msgstr "Activer la synchronisation des champs personnalisés"

msgid "Sync ACF and custom meta fields as Shopify metafields."
msgstr "Synchroniser les champs ACF et méta personnalisés comme métachamps Shopify."

msgid "Author Mapping"
msgstr "Mappage des auteurs"

msgid "Map WordPress authors to Shopify staff accounts."
msgstr "Mapper les auteurs WordPress aux comptes staff Shopify."

msgid "WordPress Author"
msgstr "Auteur WordPress"

msgid "Shopify Staff"
msgstr "Staff Shopify"

msgid "Select staff member"
msgstr "Sélectionner un membre du staff"

msgid "Save Author Mappings"
msgstr "Enregistrer les mappages d'auteurs"

msgid "Post Types to Sync"
msgstr "Types de posts à synchroniser"

msgid "Select which post types should be synced to Shopify."
msgstr "Sélectionnez quels types de posts doivent être synchronisés vers Shopify."

msgid "Automatic Sync"
msgstr "Synchronisation automatique"

msgid "Automatically sync content when published or updated."
msgstr "Synchroniser automatiquement le contenu lors de la publication ou mise à jour."

msgid "Sync on Publish"
msgstr "Synchroniser à la publication"

msgid "Sync on Update"
msgstr "Synchroniser à la mise à jour"

msgid "Sync on Delete"
msgstr "Synchroniser à la suppression"

msgid "Delete from Shopify when trashed in WordPress."
msgstr "Supprimer de Shopify quand mis à la corbeille dans WordPress."

msgid "Debug Mode"
msgstr "Mode débogage"

msgid "Enable debug logging"
msgstr "Activer la journalisation de débogage"

msgid "Log detailed sync information for troubleshooting."
msgstr "Journaliser les informations détaillées de synchronisation pour le dépannage."

msgid "Clear All Data"
msgstr "Effacer toutes les données"

msgid "Remove all sync data and mappings"
msgstr "Supprimer toutes les données de synchronisation et mappages"

msgid "This will clear all sync history and Shopify article IDs. Use with caution."
msgstr "Ceci effacera tout l'historique de synchronisation et les IDs d'articles Shopify. Utilisez avec précaution."

msgid "Save Settings"
msgstr "Enregistrer les paramètres"
