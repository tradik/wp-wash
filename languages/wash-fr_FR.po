msgstr "Boutique Shopify"

msgid "Your Shopify store handle (e.g., \"my-store\" from my-store.myshopify.com)"
msgstr "L'identifiant de votre boutique Shopify (ex. \"ma-boutique\" de ma-boutique.myshopify.com)"

