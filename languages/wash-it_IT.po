msgstr "Avanzate"

msgid "Shopify Store Connection"
msgstr "Connessione negozio Shopify"

msgid "Connected"
msgstr "Connesso"

msgid "Shopify Store"
msgstr "Negozio Shopify"

msgid "Your Shopify store handle (e.g., \"my-store\" from my-store.myshopify.com)"
msgstr "L'identificatore del tuo negozio Shopify (es. \"mio-negozio\" da mio-negozio.myshopify.com)"

msgid "Connect to Shopify"
msgstr "Connetti a Shopify"

msgid "Disconnect"
msgstr "Disconnetti"

msgid "Manual Configuration"
msgstr "Configurazione manuale"

msgid "If automatic connection fails, you can enter credentials manually."
msgstr "Se la connessione automatica fallisce, puoi inserire le credenziali manualmente."

msgid "API Key"
msgstr "Chiave API"

msgid "API Secret"
msgstr "Segreto API"

msgid "Hide manual configuration"
msgstr "Nascondi configurazione manuale"

msgid "Enter credentials manually"
msgstr "Inserisci credenziali manualmente"

msgid "HTTP Authentication (Optional)"
msgstr "Autenticazione HTTP (Opzionale)"

msgid "For apps behind Basic Auth"
msgstr "Per app dietro Basic Auth"

msgid "HTTP Username"
msgstr "Nome utente HTTP"

msgid "HTTP Password"
msgstr "Password HTTP"

msgid "Test Connection"
msgstr "Testa connessione"

msgid "Debug Session"
msgstr "Debug sessione"

msgid "Reset Session"
msgstr "Reimposta sessione"

msgid "Blog Routing Rules"
msgstr "Regole di routing blog"

msgid "Route WordPress posts to different Shopify blogs based on language or category."
msgstr "Instrada i post WordPress a diversi blog Shopify in base a lingua o categoria."

msgid "Higher priority rules are matched first. Default rule is used when no other rule matches."
msgstr "Le regole con priorità più alta vengono elaborate per prime. La regola predefinita viene usata quando nessun'altra regola corrisponde."

msgid "Connect to Shopify first to configure blog mappings."
msgstr "Connettiti prima a Shopify per configurare le mappature dei blog."

msgid "Loading mappings..."
msgstr "Caricamento mappature..."

msgid "Add Mapping Rule"
msgstr "Aggiungi regola di mappatura"

msgid "Rule Type"
msgstr "Tipo di regola"

msgid "Default (catch-all)"
msgstr "Predefinito (catch-all)"

msgid "By Language"
msgstr "Per lingua"

msgid "By Category"
msgstr "Per categoria"

msgid "Value"
msgstr "Valore"

msgid "Language code (en, de, pl) or category slug"
msgstr "Codice lingua (en, de, pl) o slug categoria"

msgid "Target Shopify Blog"
msgstr "Blog Shopify di destinazione"

msgid "Select a blog..."
msgstr "Seleziona un blog..."

msgid "Create new blog"
msgstr "Crea nuovo blog"

msgid "New blog name (e.g., blog-en)"
msgstr "Nome nuovo blog (es. blog-it)"

msgid "Priority"
msgstr "Priorità"

msgid "Higher priority rules are matched first (0-100)"
msgstr "Le regole con priorità più alta vengono elaborate per prime (0-100)"

msgid "Save Mapping"
msgstr "Salva mappatura"

msgid "Cancel"
msgstr "Annulla"

msgid "URL Redirections Management"
msgstr "Gestione reindirizzamenti URL"

msgid "Manage 301 redirects from WordPress URLs to Shopify URLs for SEO preservation during migration."
msgstr "Gestisci i reindirizzamenti 301 dagli URL WordPress agli URL Shopify per la preservazione SEO durante la migrazione."

msgid "Redirections Manager"
msgstr "Gestore reindirizzamenti"

msgid "Loading redirect stats..."
msgstr "Caricamento statistiche reindirizzamenti..."

msgid "Sync from Old Website"
msgstr "Sincronizza dal vecchio sito"

msgid "Generate from Synced Posts"
msgstr "Genera dai post sincronizzati"

msgid "Load from Shopify"
msgstr "Carica da Shopify"

msgid "Fix Session Scopes"
msgstr "Correggi ambiti sessione"

msgid "Redirections List"
msgstr "Lista reindirizzamenti"

msgid "format: /old-path -> /new-path"
msgstr "formato: /vecchio-percorso -> /nuovo-percorso"

msgid "Enter one redirection per line. You can use ->, =>, or → as separator. Lines starting with # are ignored."
msgstr "Inserisci un reindirizzamento per riga. Puoi usare ->, => o → come separatore. Le righe che iniziano con # vengono ignorate."

msgid "Sync Redirections to Shopify"
msgstr "Sincronizza reindirizzamenti su Shopify"

msgid "Sync Complete"
msgstr "Sincronizzazione completata"

msgid "Connect to Shopify first to manage redirections."
msgstr "Connettiti prima a Shopify per gestire i reindirizzamenti."

msgid "URL Structure Guide"
msgstr "Guida struttura URL"

msgid "WordPress URL Structure (Current)"
msgstr "Struttura URL WordPress (Attuale)"

msgid "Your WordPress site currently serves content with these URL patterns:"
msgstr "Il tuo sito WordPress attualmente serve contenuti con questi pattern URL:"

msgid "Blog Posts"
msgstr "Articoli del blog"

msgid "Permalink structure depends on Settings → Permalinks"
msgstr "La struttura permalink dipende da Impostazioni → Permalink"

msgid "Pages"
msgstr "Pagine"

msgid "Page slug becomes the URL"
msgstr "Lo slug della pagina diventa l'URL"

msgid "Categories"
msgstr "Categorie"

msgid "Category archives with pagination"
msgstr "Archivi categoria con paginazione"

msgid "Images"
msgstr "Immagini"

msgid "Served from your WordPress server"
msgstr "Servite dal tuo server WordPress"

msgid "Shopify URL Structure (After Sync)"
msgstr "Struttura URL Shopify (Dopo sincronizzazione)"

msgid "After syncing, your content will be available on Shopify with these URL patterns:"
msgstr "Dopo la sincronizzazione, i tuoi contenuti saranno disponibili su Shopify con questi pattern URL:"

msgid "Blog handle is required in Shopify URLs. Configure in Blogs tab."
msgstr "L'identificatore del blog è richiesto negli URL Shopify. Configura nella scheda Blog."

msgid "Multi-language Posts"
msgstr "Post multilingua"

msgid "English"
msgstr "Inglese"

msgid "German"
msgstr "Tedesco"

msgid "Polish"
msgstr "Polacco"

msgid "Each language gets its own blog with routing rules."
msgstr "Ogni lingua ha il proprio blog con regole di routing."

msgid "Pages are prefixed with /pages/ in Shopify."
msgstr "Le pagine hanno il prefisso /pages/ in Shopify."

msgid "Images are uploaded to Shopify CDN for faster global delivery."
msgstr "Le immagini vengono caricate sul CDN Shopify per una consegna globale più veloce."

msgid "Image Handling"
msgstr "Gestione immagini"

msgid "Image Type"
msgstr "Tipo di immagine"

msgid "What Happens"
msgstr "Cosa succede"

msgid "Featured Image"
msgstr "Immagine in evidenza"

msgid "Uploaded to Shopify and set as article image. Displayed in blog listings and article headers."
msgstr "Caricata su Shopify e impostata come immagine articolo. Visualizzata nelle liste blog e nelle intestazioni articoli."

msgid "Inline Images"
msgstr "Immagini inline"

msgid "Uploaded to Shopify CDN. URLs in content are automatically rewritten."
msgstr "Caricate sul CDN Shopify. Gli URL nel contenuto vengono riscritti automaticamente."

msgid "Gallery Images"
msgstr "Immagini galleria"

msgid "Uploaded to Shopify CDN. Gallery shortcodes converted to HTML."
msgstr "Caricate sul CDN Shopify. Gli shortcode galleria vengono convertiti in HTML."

msgid "Requires %s plan"
msgstr "Richiede il piano %s"

msgid "None detected"
msgstr "Nessuno rilevato"

msgid "Settings"
msgstr "Impostazioni"

msgid "Sync Now"
msgstr "Sincronizza ora"

msgid "Sync in progress..."
msgstr "Sincronizzazione in corso..."

msgid "Synced successfully"
msgstr "Sincronizzato con successo"

msgid "Sync failed"
msgstr "Sincronizzazione fallita"

msgid "Last synced:"
msgstr "Ultima sincronizzazione:"

msgid "Never synced"
msgstr "Mai sincronizzato"

msgid "Error:"
msgstr "Errore:"

msgid "Success:"
msgstr "Successo:"

msgid "Hreflang Synchronization"
msgstr "Sincronizzazione Hreflang"

msgid "Enable hreflang synchronization"
msgstr "Abilita sincronizzazione hreflang"

msgid "Detected multilingual plugin:"
msgstr "Plugin multilingua rilevato:"

msgid "Automatically sync hreflang tags for multilingual content."
msgstr "Sincronizza automaticamente i tag hreflang per contenuti multilingua."

msgid "Custom Fields Sync"
msgstr "Sincronizzazione campi personalizzati"

msgid "Enable custom fields sync"
msgstr "Abilita sincronizzazione campi personalizzati"

msgid "Sync ACF and custom meta fields as Shopify metafields."
msgstr "Sincronizza campi ACF e meta personalizzati come metacampi Shopify."

msgid "Author Mapping"
msgstr "Mappatura autori"

msgid "Map WordPress authors to Shopify staff accounts."
msgstr "Mappa gli autori WordPress agli account staff Shopify."

msgid "WordPress Author"
msgstr "Autore WordPress"

msgid "Shopify Staff"
msgstr "Staff Shopify"

msgid "Select staff member"
msgstr "Seleziona membro staff"

msgid "Save Author Mappings"
msgstr "Salva mappature autori"

msgid "Post Types to Sync"
msgstr "Tipi di post da sincronizzare"

msgid "Select which post types should be synced to Shopify."
msgstr "Seleziona quali tipi di post devono essere sincronizzati su Shopify."

msgid "Automatic Sync"
msgstr "Sincronizzazione automatica"

msgid "Automatically sync content when published or updated."
msgstr "Sincronizza automaticamente il contenuto quando pubblicato o aggiornato."

msgid "Sync on Publish"
msgstr "Sincronizza alla pubblicazione"

msgid "Sync on Update"
msgstr "Sincronizza all'aggiornamento"

msgid "Sync on Delete"
msgstr "Sincronizza all'eliminazione"

msgid "Delete from Shopify when trashed in WordPress."
msgstr "Elimina da Shopify quando spostato nel cestino in WordPress."

msgid "Debug Mode"
msgstr "Modalità debug"

msgid "Enable debug logging"
msgstr "Abilita log di debug"

msgid "Log detailed sync information for troubleshooting."
msgstr "Registra informazioni dettagliate di sincronizzazione per la risoluzione problemi."

msgid "Clear All Data"
msgstr "Cancella tutti i dati"

msgid "Remove all sync data and mappings"
msgstr "Rimuovi tutti i dati di sincronizzazione e mappature"

msgid "This will clear all sync history and Shopify article IDs. Use with caution."
msgstr "Questo cancellerà tutta la cronologia sincronizzazione e gli ID articoli Shopify. Usare con cautela."

msgid "Save Settings"
msgstr "Salva impostazioni"
