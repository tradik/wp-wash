msgid "wash Settings"
msgstr "wash 설정"

msgid "Articles:"
msgstr "기사:"

msgid "(unlimited)"
msgstr "(무제한)"

msgid "Edits:"
msgstr "편집:"

msgid "Upgrade Plan"
msgstr "플랜 업그레이드"

msgid "Connection"
msgstr "연결"

msgid "Blogs"
msgstr "블로그"

msgid "Redirections"
msgstr "리디렉션"

msgid "Hreflangs"
msgstr "Hreflang"

msgid "Meta Fields"
msgstr "메타 필드"

msgid "Authors"
msgstr "작성자"

msgid "Files & Media"
msgstr "파일 및 미디어"

msgid "Sync Settings"
msgstr "동기화 설정"

msgid "Advanced"
msgstr "고급"

msgid "Shopify Store Connection"
msgstr "Shopify 스토어 연결"

msgid "Connected"
msgstr "연결됨"

msgid "Shopify Store"
msgstr "Shopify 스토어"

msgid "Your Shopify store handle (e.g., \"my-store\" from my-store.myshopify.com)"
msgstr "Shopify 스토어 핸들 (예: my-store.myshopify.com의 \"my-store\")"

msgid "Connect to Shopify"
msgstr "Shopify에 연결"

msgid "Disconnect"
msgstr "연결 끊기"

msgid "Manual Configuration"
msgstr "수동 구성"

msgid "If automatic connection fails, you can enter credentials manually."
msgstr "자동 연결이 실패하면 자격 증명을 수동으로 입력할 수 있습니다."

msgid "API Key"
msgstr "API 키"

msgid "API Secret"
msgstr "API 시크릿"

msgid "Hide manual configuration"
msgstr "수동 구성 숨기기"

msgid "Enter credentials manually"
msgstr "자격 증명 수동 입력"

msgid "HTTP Authentication (Optional)"
msgstr "HTTP 인증 (선택 사항)"

msgid "For apps behind Basic Auth"
msgstr "Basic Auth 뒤의 앱용"

msgid "HTTP Username"
msgstr "HTTP 사용자 이름"

msgid "HTTP Password"
msgstr "HTTP 비밀번호"

msgid "Test Connection"
msgstr "연결 테스트"

msgid "Debug Session"
msgstr "디버그 세션"

msgid "Reset Session"
msgstr "세션 재설정"

msgid "Blog Routing Rules"
msgstr "블로그 라우팅 규칙"

msgid "Route WordPress posts to different Shopify blogs based on language or category."
msgstr "언어 또는 카테고리에 따라 WordPress 게시물을 다른 Shopify 블로그로 라우팅합니다."

msgid "Higher priority rules are matched first. Default rule is used when no other rule matches."
msgstr "우선 순위가 높은 규칙이 먼저 매칭됩니다. 다른 규칙이 매칭되지 않으면 기본 규칙이 사용됩니다."

msgid "Connect to Shopify first to configure blog mappings."
msgstr "블로그 매핑을 구성하려면 먼저 Shopify에 연결하세요."

msgid "Loading mappings..."
msgstr "매핑 로드 중..."

msgid "Add Mapping Rule"
msgstr "매핑 규칙 추가"

msgid "Rule Type"
msgstr "규칙 유형"

msgid "Default (catch-all)"
msgstr "기본값 (캐치올)"

msgid "By Language"
msgstr "언어별"

msgid "By Category"
msgstr "카테고리별"

msgid "Value"
msgstr "값"

msgid "Language code (en, de, pl) or category slug"
msgstr "언어 코드 (en, de, pl) 또는 카테고리 슬러그"

msgid "Target Shopify Blog"
msgstr "대상 Shopify 블로그"

msgid "Select a blog..."
msgstr "블로그 선택..."

msgid "Create new blog"
msgstr "새 블로그 만들기"

msgid "New blog name (e.g., blog-en)"
msgstr "새 블로그 이름 (예: blog-ko)"

msgid "Priority"
msgstr "우선순위"

msgid "Higher priority rules are matched first (0-100)"
msgstr "우선 순위가 높은 규칙이 먼저 매칭됩니다 (0-100)"

msgid "Save Mapping"
msgstr "매핑 저장"

msgid "Cancel"
msgstr "취소"

msgid "URL Redirections Management"
msgstr "URL 리디렉션 관리"

msgid "Manage 301 redirects from WordPress URLs to Shopify URLs for SEO preservation during migration."
msgstr "마이그레이션 중 SEO 유지를 위해 WordPress URL에서 Shopify URL로의 301 리디렉션을 관리합니다."

msgid "Redirections Manager"
msgstr "리디렉션 관리자"

msgid "Loading redirect stats..."
msgstr "리디렉션 통계 로드 중..."

msgid "Sync from Old Website"
msgstr "이전 웹사이트에서 동기화"

msgid "Generate from Synced Posts"
msgstr "동기화된 게시물에서 생성"

msgid "Load from Shopify"
msgstr "Shopify에서 로드"

msgid "Fix Session Scopes"
msgstr "세션 범위 수정"

msgid "Redirections List"
msgstr "리디렉션 목록"

msgid "format: /old-path -> /new-path"
msgstr "형식: /이전경로 -> /새경로"

msgid "Enter one redirection per line. You can use ->, =>, or → as separator. Lines starting with # are ignored."
msgstr "한 줄에 하나의 리디렉션을 입력하세요. ->, => 또는 →를 구분자로 사용할 수 있습니다. #로 시작하는 줄은 무시됩니다."

msgid "Sync Redirections to Shopify"
msgstr "리디렉션을 Shopify에 동기화"

msgid "Sync Complete"
msgstr "동기화 완료"

msgid "Connect to Shopify first to manage redirections."
msgstr "리디렉션을 관리하려면 먼저 Shopify에 연결하세요."

msgid "URL Structure Guide"
msgstr "URL 구조 가이드"

msgid "WordPress URL Structure (Current)"
msgstr "WordPress URL 구조 (현재)"

msgid "Your WordPress site currently serves content with these URL patterns:"
msgstr "WordPress 사이트는 현재 이러한 URL 패턴으로 콘텐츠를 제공합니다:"

msgid "Blog Posts"
msgstr "블로그 게시물"

msgid "Permalink structure depends on Settings → Permalinks"
msgstr "퍼머링크 구조는 설정 → 고유주소에 따라 다릅니다"

msgid "Pages"
msgstr "페이지"

msgid "Page slug becomes the URL"
msgstr "페이지 슬러그가 URL이 됩니다"

msgid "Categories"
msgstr "카테고리"

msgid "Category archives with pagination"
msgstr "페이지네이션이 있는 카테고리 아카이브"

msgid "Images"
msgstr "이미지"

msgid "Served from your WordPress server"
msgstr "WordPress 서버에서 제공"

msgid "Shopify URL Structure (After Sync)"
msgstr "Shopify URL 구조 (동기화 후)"

msgid "After syncing, your content will be available on Shopify with these URL patterns:"
msgstr "동기화 후 콘텐츠는 이러한 URL 패턴으로 Shopify에서 사용할 수 있습니다:"

msgid "Blog handle is required in Shopify URLs. Configure in Blogs tab."
msgstr "Shopify URL에는 블로그 핸들이 필요합니다. 블로그 탭에서 구성하세요."

msgid "Multi-language Posts"
msgstr "다국어 게시물"

msgid "English"
msgstr "영어"

msgid "German"
msgstr "독일어"

msgid "Polish"
msgstr "폴란드어"

msgid "Each language gets its own blog with routing rules."
msgstr "각 언어는 라우팅 규칙이 있는 자체 블로그를 갖습니다."

msgid "Pages are prefixed with /pages/ in Shopify."
msgstr "페이지는 Shopify에서 /pages/ 접두사가 붙습니다."

msgid "Images are uploaded to Shopify CDN for faster global delivery."
msgstr "이미지는 더 빠른 글로벌 전송을 위해 Shopify CDN에 업로드됩니다."

msgid "Image Handling"
msgstr "이미지 처리"

msgid "Image Type"
msgstr "이미지 유형"

msgid "What Happens"
msgstr "어떤 일이 발생하나요"

msgid "Featured Image"
msgstr "대표 이미지"

msgid "Uploaded to Shopify and set as article image. Displayed in blog listings and article headers."
msgstr "Shopify에 업로드되어 기사 이미지로 설정됩니다. 블로그 목록 및 기사 헤더에 표시됩니다."

msgid "Inline Images"
msgstr "인라인 이미지"

msgid "Uploaded to Shopify CDN. URLs in content are automatically rewritten."
msgstr "Shopify CDN에 업로드됩니다. 콘텐츠의 URL이 자동으로 다시 작성됩니다."

msgid "Gallery Images"
msgstr "갤러리 이미지"

msgid "Uploaded to Shopify CDN. Gallery shortcodes converted to HTML."
msgstr "Shopify CDN에 업로드됩니다. 갤러리 숏코드가 HTML로 변환됩니다."

msgid "Requires %s plan"
msgstr "%s 플랜 필요"

msgid "None detected"
msgstr "감지되지 않음"

msgid "Settings"
msgstr "설정"

msgid "Sync Now"
msgstr "지금 동기화"

msgid "Sync in progress..."
msgstr "동기화 중..."

msgid "Synced successfully"
msgstr "성공적으로 동기화됨"

msgid "Sync failed"
msgstr "동기화 실패"

msgid "Last synced:"
msgstr "마지막 동기화:"

msgid "Never synced"
msgstr "동기화된 적 없음"

msgid "Error:"
msgstr "오류:"

msgid "Success:"
msgstr "성공:"

msgid "Hreflang Synchronization"
msgstr "Hreflang 동기화"

msgid "Enable hreflang synchronization"
msgstr "Hreflang 동기화 활성화"

msgid "Detected multilingual plugin:"
msgstr "감지된 다국어 플러그인:"

msgid "Automatically sync hreflang tags for multilingual content."
msgstr "다국어 콘텐츠에 대한 hreflang 태그를 자동으로 동기화합니다."

msgid "Custom Fields Sync"
msgstr "사용자 정의 필드 동기화"

msgid "Enable custom fields sync"
msgstr "사용자 정의 필드 동기화 활성화"

msgid "Sync ACF and custom meta fields as Shopify metafields."
msgstr "ACF 및 사용자 정의 메타 필드를 Shopify 메타필드로 동기화합니다."

msgid "Author Mapping"
msgstr "작성자 매핑"

msgid "Map WordPress authors to Shopify staff accounts."
msgstr "WordPress 작성자를 Shopify 직원 계정에 매핑합니다."

msgid "WordPress Author"
msgstr "WordPress 작성자"

msgid "Shopify Staff"
msgstr "Shopify 직원"

msgid "Select staff member"
msgstr "직원 선택"

msgid "Save Author Mappings"
msgstr "작성자 매핑 저장"

msgid "Post Types to Sync"
msgstr "동기화할 게시물 유형"

msgid "Select which post types should be synced to Shopify."
msgstr "Shopify에 동기화할 게시물 유형을 선택하세요."

msgid "Automatic Sync"
msgstr "자동 동기화"

msgid "Automatically sync content when published or updated."
msgstr "게시 또는 업데이트 시 콘텐츠를 자동으로 동기화합니다."

msgid "Sync on Publish"
msgstr "게시 시 동기화"

msgid "Sync on Update"
msgstr "업데이트 시 동기화"

msgid "Sync on Delete"
msgstr "삭제 시 동기화"

msgid "Delete from Shopify when trashed in WordPress."
msgstr "WordPress에서 휴지통으로 이동 시 Shopify에서 삭제합니다."

msgid "Debug Mode"
msgstr "디버그 모드"

msgid "Enable debug logging"
msgstr "디버그 로깅 활성화"

msgid "Log detailed sync information for troubleshooting."
msgstr "문제 해결을 위한 상세한 동기화 정보를 로그에 기록합니다."

msgid "Clear All Data"
msgstr "모든 데이터 삭제"

msgid "Remove all sync data and mappings"
msgstr "모든 동기화 데이터 및 매핑 제거"

msgid "This will clear all sync history and Shopify article IDs. Use with caution."
msgstr "이렇게 하면 모든 동기화 기록 및 Shopify 기사 ID가 삭제됩니다. 주의해서 사용하세요."

msgid "Save Settings"
msgstr "설정 저장"
