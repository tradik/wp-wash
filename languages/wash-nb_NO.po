msgid "wash Settings"
msgstr "wash-innstillinger"

msgid "Articles:"
msgstr "Artikler:"

msgid "(unlimited)"
msgstr "(ubegrenset)"

msgid "Edits:"
msgstr "Redigeringer:"

msgid "Upgrade Plan"
msgstr "Oppgrader plan"

msgid "Connection"
msgstr "Tilkobling"

msgid "Blogs"
msgstr "Blogger"

msgid "Redirections"
msgstr "Omdirigeringer"

msgid "Hreflangs"
msgstr "Hreflangs"

msgid "Meta Fields"
msgstr "Metafelt"

msgid "Authors"
msgstr "Forfattere"

msgid "Files & Media"
msgstr "Filer og media"

msgid "Sync Settings"
msgstr "Synkroniseringsinnstillinger"

msgid "Advanced"
msgstr "Avansert"

msgid "Shopify Store Connection"
msgstr "Shopify-butikktilkobling"

msgid "Connected"
msgstr "Tilkoblet"

msgid "Shopify Store"
msgstr "Shopify-butikk"

msgid "Your Shopify store handle (e.g., \"my-store\" from my-store.myshopify.com)"
msgstr "Din Shopify-butikkidentifikator (f.eks. \"min-butikk\" fra min-butikk.myshopify.com)"

msgid "Connect to Shopify"
msgstr "Koble til Shopify"

msgid "Disconnect"
msgstr "Koble fra"

msgid "Manual Configuration"
msgstr "Manuell konfigurasjon"

msgid "If automatic connection fails, you can enter credentials manually."
msgstr "Hvis automatisk tilkobling mislykkes, kan du skrive inn legitimasjonen manuelt."

msgid "API Key"
msgstr "API-nøkkel"

msgid "API Secret"
msgstr "API-hemmelighet"

msgid "Hide manual configuration"
msgstr "Skjul manuell konfigurasjon"

msgid "Enter credentials manually"
msgstr "Skriv inn legitimasjon manuelt"

msgid "HTTP Authentication (Optional)"
msgstr "HTTP-autentisering (Valgfritt)"

msgid "For apps behind Basic Auth"
msgstr "For apper bak Basic Auth"

msgid "HTTP Username"
msgstr "HTTP-brukernavn"

msgid "HTTP Password"
msgstr "HTTP-passord"

msgid "Test Connection"
msgstr "Test tilkobling"

msgid "Debug Session"
msgstr "Debug økt"

msgid "Reset Session"
msgstr "Tilbakestill økt"

msgid "Blog Routing Rules"
msgstr "Bloggruting-regler"

msgid "Route WordPress posts to different Shopify blogs based on language or category."
msgstr "Rut WordPress-innlegg til forskjellige Shopify-blogger basert på språk eller kategori."

msgid "Higher priority rules are matched first. Default rule is used when no other rule matches."
msgstr "Regler med høyere prioritet behandles først. Standardregelen brukes når ingen andre regler passer."

msgid "Connect to Shopify first to configure blog mappings."
msgstr "Koble til Shopify først for å konfigurere bloggkoblinger."

msgid "Loading mappings..."
msgstr "Laster koblinger..."

msgid "Add Mapping Rule"
msgstr "Legg til koblingsregel"

msgid "Rule Type"
msgstr "Regeltype"

msgid "Default (catch-all)"
msgstr "Standard (catch-all)"

msgid "By Language"
msgstr "Etter språk"

msgid "By Category"
msgstr "Etter kategori"

msgid "Value"
msgstr "Verdi"

msgid "Language code (en, de, pl) or category slug"
msgstr "Språkkode (en, de, pl) eller kategori-slug"

msgid "Target Shopify Blog"
msgstr "Mål Shopify-blogg"

msgid "Select a blog..."
msgstr "Velg en blogg..."

msgid "Create new blog"
msgstr "Opprett ny blogg"

msgid "New blog name (e.g., blog-en)"
msgstr "Nytt bloggnavn (f.eks. blogg-no)"

msgid "Priority"
msgstr "Prioritet"

msgid "Higher priority rules are matched first (0-100)"
msgstr "Regler med høyere prioritet behandles først (0-100)"

msgid "Save Mapping"
msgstr "Lagre kobling"

msgid "Cancel"
msgstr "Avbryt"

msgid "URL Redirections Management"
msgstr "URL-omdirigeringsadministrasjon"

msgid "Manage 301 redirects from WordPress URLs to Shopify URLs for SEO preservation during migration."
msgstr "Administrer 301-omdirigeringer fra WordPress-URLer til Shopify-URLer for SEO-bevaring under migrering."

msgid "Redirections Manager"
msgstr "Omdirigeringsadministrator"

msgid "Loading redirect stats..."
msgstr "Laster omdirigeringsstatistikk..."

msgid "Sync from Old Website"
msgstr "Synkroniser fra gammelt nettsted"

msgid "Generate from Synced Posts"
msgstr "Generer fra synkroniserte innlegg"

msgid "Load from Shopify"
msgstr "Last fra Shopify"

msgid "Fix Session Scopes"
msgstr "Reparer øktomfang"

msgid "Redirections List"
msgstr "Omdirigeringsliste"

msgid "format: /old-path -> /new-path"
msgstr "format: /gammel-sti -> /ny-sti"

msgid "Enter one redirection per line. You can use ->, =>, or → as separator. Lines starting with # are ignored."
msgstr "Skriv inn én omdirigering per linje. Du kan bruke ->, => eller → som skilletegn. Linjer som starter med # ignoreres."

msgid "Sync Redirections to Shopify"
msgstr "Synkroniser omdirigeringer til Shopify"

msgid "Sync Complete"
msgstr "Synkronisering fullført"

msgid "Connect to Shopify first to manage redirections."
msgstr "Koble til Shopify først for å administrere omdirigeringer."

msgid "URL Structure Guide"
msgstr "URL-strukturguide"

msgid "WordPress URL Structure (Current)"
msgstr "WordPress URL-struktur (Nåværende)"

msgid "Your WordPress site currently serves content with these URL patterns:"
msgstr "WordPress-nettstedet ditt serverer for øyeblikket innhold med disse URL-mønstrene:"

msgid "Blog Posts"
msgstr "Blogginnlegg"

msgid "Permalink structure depends on Settings → Permalinks"
msgstr "Permalink-struktur avhenger av Innstillinger → Permalenker"

msgid "Pages"
msgstr "Sider"

msgid "Page slug becomes the URL"
msgstr "Side-slug blir URL-en"

msgid "Categories"
msgstr "Kategorier"

msgid "Category archives with pagination"
msgstr "Kategoriarkiver med paginering"

msgid "Images"
msgstr "Bilder"

msgid "Served from your WordPress server"
msgstr "Servert fra WordPress-serveren din"

msgid "Shopify URL Structure (After Sync)"
msgstr "Shopify URL-struktur (Etter synkronisering)"

msgid "After syncing, your content will be available on Shopify with these URL patterns:"
msgstr "Etter synkronisering vil innholdet ditt være tilgjengelig på Shopify med disse URL-mønstrene:"

msgid "Blog handle is required in Shopify URLs. Configure in Blogs tab."
msgstr "Bloggidentifikator er påkrevd i Shopify-URLer. Konfigurer i Blogger-fanen."

msgid "Multi-language Posts"
msgstr "Flerspråklige innlegg"

msgid "English"
msgstr "Engelsk"

msgid "German"
msgstr "Tysk"

msgid "Polish"
msgstr "Polsk"

msgid "Each language gets its own blog with routing rules."
msgstr "Hvert språk får sin egen blogg med rutingsregler."

msgid "Pages are prefixed with /pages/ in Shopify."
msgstr "Sider har prefikset /pages/ i Shopify."

msgid "Images are uploaded to Shopify CDN for faster global delivery."
msgstr "Bilder lastes opp til Shopify CDN for raskere global levering."

msgid "Image Handling"
msgstr "Bildehåndtering"

msgid "Image Type"
msgstr "Bildetype"

msgid "What Happens"
msgstr "Hva skjer"

msgid "Featured Image"
msgstr "Fremhevet bilde"

msgid "Uploaded to Shopify and set as article image. Displayed in blog listings and article headers."
msgstr "Lastet opp til Shopify og satt som artikkelbilde. Vises i blogglister og artikkeloverskrifter."

msgid "Inline Images"
msgstr "Innebygde bilder"

msgid "Uploaded to Shopify CDN. URLs in content are automatically rewritten."
msgstr "Lastet opp til Shopify CDN. URLer i innhold blir automatisk omskrevet."

msgid "Gallery Images"
msgstr "Galleribilder"

msgid "Uploaded to Shopify CDN. Gallery shortcodes converted to HTML."
msgstr "Lastet opp til Shopify CDN. Galleri-kortkoder konverteres til HTML."

msgid "Requires %s plan"
msgstr "Krever %s-plan"

msgid "None detected"
msgstr "Ingen oppdaget"

msgid "Settings"
msgstr "Innstillinger"

msgid "Sync Now"
msgstr "Synkroniser nå"

msgid "Sync in progress..."
msgstr "Synkronisering pågår..."

msgid "Synced successfully"
msgstr "Synkronisert vellykket"

msgid "Sync failed"
msgstr "Synkronisering mislyktes"

msgid "Last synced:"
msgstr "Sist synkronisert:"

msgid "Never synced"
msgstr "Aldri synkronisert"

msgid "Error:"
msgstr "Feil:"

msgid "Success:"
msgstr "Suksess:"

msgid "Hreflang Synchronization"
msgstr "Hreflang-synkronisering"

msgid "Enable hreflang synchronization"
msgstr "Aktiver hreflang-synkronisering"

msgid "Detected multilingual plugin:"
msgstr "Oppdaget flerspråklig plugin:"

msgid "Automatically sync hreflang tags for multilingual content."
msgstr "Synkroniser hreflang-tagger for flerspråklig innhold automatisk."

msgid "Custom Fields Sync"
msgstr "Synkronisering av egendefinerte felt"

msgid "Enable custom fields sync"
msgstr "Aktiver synkronisering av egendefinerte felt"

msgid "Sync ACF and custom meta fields as Shopify metafields."
msgstr "Synkroniser ACF og egendefinerte metafelt som Shopify-metafelt."

msgid "Author Mapping"
msgstr "Forfattertilordning"

msgid "Map WordPress authors to Shopify staff accounts."
msgstr "Tilordne WordPress-forfattere til Shopify-ansattkontoer."

msgid "WordPress Author"
msgstr "WordPress-forfatter"

msgid "Shopify Staff"
msgstr "Shopify-ansatt"

msgid "Select staff member"
msgstr "Velg ansatt"

msgid "Save Author Mappings"
msgstr "Lagre forfattertilordninger"

msgid "Post Types to Sync"
msgstr "Innleggstyper å synkronisere"

msgid "Select which post types should be synced to Shopify."
msgstr "Velg hvilke innleggstyper som skal synkroniseres til Shopify."

msgid "Automatic Sync"
msgstr "Automatisk synkronisering"

msgid "Automatically sync content when published or updated."
msgstr "Synkroniser innhold automatisk når det publiseres eller oppdateres."

msgid "Sync on Publish"
msgstr "Synkroniser ved publisering"

msgid "Sync on Update"
msgstr "Synkroniser ved oppdatering"

msgid "Sync on Delete"
msgstr "Synkroniser ved sletting"

msgid "Delete from Shopify when trashed in WordPress."
msgstr "Slett fra Shopify når flyttet til papirkurven i WordPress."

msgid "Debug Mode"
msgstr "Feilsøkingsmodus"

msgid "Enable debug logging"
msgstr "Aktiver feilsøkingslogging"

msgid "Log detailed sync information for troubleshooting."
msgstr "Logg detaljert synkroniseringsinformasjon for feilsøking."

msgid "Clear All Data"
msgstr "Slett alle data"

msgid "Remove all sync data and mappings"
msgstr "Fjern alle synkroniseringsdata og tilordninger"

msgid "This will clear all sync history and Shopify article IDs. Use with caution."
msgstr "Dette vil slette all synkroniseringshistorikk og Shopify-artikkel-IDer. Bruk med forsiktighet."

msgid "Save Settings"
msgstr "Lagre innstillinger"
