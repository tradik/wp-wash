msgstr "Synkroniseringsinställningar"

msgid "Advanced"
msgstr "Avancerat"

msgid "Shopify Store Connection"
msgstr "Shopify-butiksanslutning"

msgid "Connected"
msgstr "Ansluten"

msgid "Shopify Store"
msgstr "Shopify-butik"

msgid "Your Shopify store handle (e.g., \"my-store\" from my-store.myshopify.com)"
msgstr "Din Shopify-butiksidentifierare (t.ex. \"min-butik\" från min-butik.myshopify.com)"

msgid "Connect to Shopify"
msgstr "Anslut till Shopify"

msgid "Disconnect"
msgstr "Koppla från"

msgid "Manual Configuration"
msgstr "Manuell konfiguration"

msgid "If automatic connection fails, you can enter credentials manually."
msgstr "Om automatisk anslutning misslyckas kan du ange uppgifterna manuellt."

msgid "API Key"
msgstr "API-nyckel"

msgid "API Secret"
msgstr "API-hemlighet"

msgid "Hide manual configuration"
msgstr "Dölj manuell konfiguration"

msgid "Enter credentials manually"
msgstr "Ange uppgifter manuellt"

msgid "HTTP Authentication (Optional)"
msgstr "HTTP-autentisering (Valfritt)"

msgid "For apps behind Basic Auth"
msgstr "För appar bakom Basic Auth"

msgid "HTTP Username"
msgstr "HTTP-användarnamn"

msgid "HTTP Password"
msgstr "HTTP-lösenord"

msgid "Test Connection"
msgstr "Testa anslutning"

msgid "Debug Session"
msgstr "Felsökningssession"

msgid "Reset Session"
msgstr "Återställ session"

msgid "Blog Routing Rules"
msgstr "Bloggroutingregler"

msgid "Route WordPress posts to different Shopify blogs based on language or category."
msgstr "Dirigera WordPress-inlägg till olika Shopify-bloggar baserat på språk eller kategori."

msgid "Higher priority rules are matched first. Default rule is used when no other rule matches."
msgstr "Regler med högre prioritet matchas först. Standardregeln används när ingen annan regel matchar."

msgid "Connect to Shopify first to configure blog mappings."
msgstr "Anslut till Shopify först för att konfigurera bloggmappningar."

msgid "Loading mappings..."
msgstr "Laddar mappningar..."

msgid "Add Mapping Rule"
msgstr "Lägg till mappningsregel"

msgid "Rule Type"
msgstr "Regeltyp"

msgid "Default (catch-all)"
msgstr "Standard (catch-all)"

msgid "By Language"
msgstr "Efter språk"

msgid "By Category"
msgstr "Efter kategori"

msgid "Value"
msgstr "Värde"

msgid "Language code (en, de, pl) or category slug"
msgstr "Språkkod (en, de, pl) eller kategori-slug"

msgid "Target Shopify Blog"
msgstr "Mål Shopify-blogg"

msgid "Select a blog..."
msgstr "Välj en blogg..."

msgid "Create new blog"
msgstr "Skapa ny blogg"

msgid "New blog name (e.g., blog-en)"
msgstr "Nytt bloggnamn (t.ex. blogg-sv)"

msgid "Priority"
msgstr "Prioritet"

msgid "Higher priority rules are matched first (0-100)"
msgstr "Regler med högre prioritet matchas först (0-100)"

msgid "Save Mapping"
msgstr "Spara mappning"

msgid "Cancel"
msgstr "Avbryt"

msgid "URL Redirections Management"
msgstr "URL-omdirigeringshantering"

msgid "Manage 301 redirects from WordPress URLs to Shopify URLs for SEO preservation during migration."
msgstr "Hantera 301-omdirigeringar från WordPress-URLer till Shopify-URLer för SEO-bevarande under migrering."

msgid "Redirections Manager"
msgstr "Omdirigeringshanterare"

msgid "Loading redirect stats..."
msgstr "Laddar omdirigeringsstatistik..."

msgid "Sync from Old Website"
msgstr "Synkronisera från gammal webbplats"

msgid "Generate from Synced Posts"
msgstr "Generera från synkroniserade inlägg"

msgid "Load from Shopify"
msgstr "Ladda från Shopify"

msgid "Fix Session Scopes"
msgstr "Åtgärda sessionsomfång"

msgid "Redirections List"
msgstr "Omdirigeringslista"

msgid "format: /old-path -> /new-path"
msgstr "format: /gammal-sökväg -> /ny-sökväg"

msgid "Enter one redirection per line. You can use ->, =>, or → as separator. Lines starting with # are ignored."
msgstr "Ange en omdirigering per rad. Du kan använda ->, => eller → som separator. Rader som börjar med # ignoreras."

msgid "Sync Redirections to Shopify"
msgstr "Synkronisera omdirigeringar till Shopify"

msgid "Sync Complete"
msgstr "Synkronisering klar"

msgid "Connect to Shopify first to manage redirections."
msgstr "Anslut till Shopify först för att hantera omdirigeringar."

msgid "URL Structure Guide"
msgstr "URL-strukturguide"

msgid "WordPress URL Structure (Current)"
msgstr "WordPress URL-struktur (Nuvarande)"

msgid "Your WordPress site currently serves content with these URL patterns:"
msgstr "Din WordPress-webbplats serverar för närvarande innehåll med dessa URL-mönster:"

msgid "Blog Posts"
msgstr "Blogginlägg"

msgid "Permalink structure depends on Settings → Permalinks"
msgstr "Permalänkstruktur beror på Inställningar → Permalänkar"

msgid "Pages"
msgstr "Sidor"

msgid "Page slug becomes the URL"
msgstr "Sidans slug blir URL:en"

msgid "Categories"
msgstr "Kategorier"

msgid "Category archives with pagination"
msgstr "Kategoriarkiv med paginering"

msgid "Images"
msgstr "Bilder"

msgid "Served from your WordPress server"
msgstr "Serveras från din WordPress-server"

msgid "Shopify URL Structure (After Sync)"
msgstr "Shopify URL-struktur (Efter synkronisering)"

msgid "After syncing, your content will be available on Shopify with these URL patterns:"
msgstr "Efter synkronisering kommer ditt innehåll att vara tillgängligt på Shopify med dessa URL-mönster:"

msgid "Blog handle is required in Shopify URLs. Configure in Blogs tab."
msgstr "Bloggidentifierare krävs i Shopify-URLer. Konfigurera i fliken Bloggar."

msgid "Multi-language Posts"
msgstr "Flerspråkiga inlägg"

msgid "English"
msgstr "Engelska"

msgid "German"
msgstr "Tyska"

msgid "Polish"
msgstr "Polska"

msgid "Each language gets its own blog with routing rules."
msgstr "Varje språk får sin egen blogg med routingregler."

msgid "Pages are prefixed with /pages/ in Shopify."
msgstr "Sidor har prefixet /pages/ i Shopify."

msgid "Images are uploaded to Shopify CDN for faster global delivery."
msgstr "Bilder laddas upp till Shopify CDN för snabbare global leverans."

msgid "Image Handling"
msgstr "Bildhantering"

msgid "Image Type"
msgstr "Bildtyp"

msgid "What Happens"
msgstr "Vad händer"

msgid "Featured Image"
msgstr "Utvald bild"

msgid "Uploaded to Shopify and set as article image. Displayed in blog listings and article headers."
msgstr "Laddas upp till Shopify och sätts som artikelbild. Visas i blogglistor och artikelrubriker."

msgid "Inline Images"
msgstr "Inbäddade bilder"

msgid "Uploaded to Shopify CDN. URLs in content are automatically rewritten."
msgstr "Laddas upp till Shopify CDN. URLer i innehåll skrivs om automatiskt."

msgid "Gallery Images"
msgstr "Galleribilder"

msgid "Uploaded to Shopify CDN. Gallery shortcodes converted to HTML."
msgstr "Laddas upp till Shopify CDN. Galleri-shortcodes konverteras till HTML."

msgid "Requires %s plan"
msgstr "Kräver %s-plan"

msgid "None detected"
msgstr "Ingen upptäckt"

msgid "Settings"
msgstr "Inställningar"

msgid "Sync Now"
msgstr "Synkronisera nu"

msgid "Sync in progress..."
msgstr "Synkronisering pågår..."

msgid "Synced successfully"
msgstr "Synkroniserad framgångsrikt"

msgid "Sync failed"
msgstr "Synkronisering misslyckades"

msgid "Last synced:"
msgstr "Senast synkroniserad:"

msgid "Never synced"
msgstr "Aldrig synkroniserad"

msgid "Error:"
msgstr "Fel:"

msgid "Success:"
msgstr "Framgång:"

msgid "Hreflang Synchronization"
msgstr "Hreflang-synkronisering"

msgid "Enable hreflang synchronization"
msgstr "Aktivera hreflang-synkronisering"

msgid "Detected multilingual plugin:"
msgstr "Upptäckt flerspråkig plugin:"

msgid "Automatically sync hreflang tags for multilingual content."
msgstr "Synkronisera hreflang-taggar för flerspråkigt innehåll automatiskt."

msgid "Custom Fields Sync"
msgstr "Synkronisering av anpassade fält"

msgid "Enable custom fields sync"
msgstr "Aktivera synkronisering av anpassade fält"

msgid "Sync ACF and custom meta fields as Shopify metafields."
msgstr "Synkronisera ACF och anpassade metafält som Shopify-metafält."

msgid "Author Mapping"
msgstr "Författarmappning"

msgid "Map WordPress authors to Shopify staff accounts."
msgstr "Mappa WordPress-författare till Shopify-personalkonton."

msgid "WordPress Author"
msgstr "WordPress-författare"

msgid "Shopify Staff"
msgstr "Shopify-personal"

msgid "Select staff member"
msgstr "Välj personalmedlem"

msgid "Save Author Mappings"
msgstr "Spara författarmappningar"

msgid "Post Types to Sync"
msgstr "Inläggstyper att synkronisera"

msgid "Select which post types should be synced to Shopify."
msgstr "Välj vilka inläggstyper som ska synkroniseras till Shopify."

msgid "Automatic Sync"
msgstr "Automatisk synkronisering"

msgid "Automatically sync content when published or updated."
msgstr "Synkronisera innehåll automatiskt vid publicering eller uppdatering."

msgid "Sync on Publish"
msgstr "Synkronisera vid publicering"

msgid "Sync on Update"
msgstr "Synkronisera vid uppdatering"

msgid "Sync on Delete"
msgstr "Synkronisera vid radering"

msgid "Delete from Shopify when trashed in WordPress."
msgstr "Radera från Shopify när det flyttas till papperskorgen i WordPress."

msgid "Debug Mode"
msgstr "Felsökningsläge"

msgid "Enable debug logging"
msgstr "Aktivera felsökningsloggning"

msgid "Log detailed sync information for troubleshooting."
msgstr "Logga detaljerad synkroniseringsinformation för felsökning."

msgid "Clear All Data"
msgstr "Rensa all data"

msgid "Remove all sync data and mappings"
msgstr "Ta bort all synkroniseringsdata och mappningar"

msgid "This will clear all sync history and Shopify article IDs. Use with caution."
msgstr "Detta rensar all synkroniseringshistorik och Shopify-artikel-IDn. Använd med försiktighet."

msgid "Save Settings"
msgstr "Spara inställningar"
